{#- 계정 1개 보고서. ctx: s, kpis, headline, issue, best, steps, campaigns -#}
{%- macro chg(d) -%}
  {%- if d -%}<div class="chg {{ d.dir }}">{{ d.text }}</div>{%- else -%}<div class="chg"></div>{%- endif -%}
{%- endmacro -%}
{%- macro comp_card(side, badge, name, desc, rows) -%}
  <div class="comp-card {{ side }}">
    <span class="comp-badge">{{ badge }}</span>
    <p class="comp-name">{{ name }}</p>
    <p class="comp-desc">{{ desc }}</p>
    {%- for r in rows %}
    <div class="comp-block">
      <div class="comp-row"><span class="l">{{ r.label }}</span><span class="v{% if loop.first %} hl{% endif %}">{{ r[side] }}</span></div>
      {{ chg(r.delta if side == 'cur' else none) }}
    </div>
    {%- endfor %}
  </div>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ s.account }} 계정 광고 운영 보고서</title>
{% include "_style.html.j2" %}
</head>
<body>
<div class="wrap">

  <header>
    <span class="eyebrow">쿠팡 광고 운영 보고 · {{ s.account }} 계정</span>
    <h1>{{ s.account }} 계정 광고 운영 보고서</h1>
    <div class="meta">{{ s.prev_label }} 실적 vs {{ s.cur_label }} 실적 &nbsp;|&nbsp; 광고전환 {{ s.window }} 기준{% if s.written %} &nbsp;|&nbsp; 작성일 {{ s.written }}{% endif %}</div>
  </header>

  <!-- ① 핵심 지표 비교 -->
  <div class="section" style="margin-top:0;">
    <div class="section-head">
      <p class="section-title">① {{ s.prev_label }} vs {{ s.cur_label }} 핵심 지표</p>
      <p class="section-sub">계정 전체 캠페인 합산 기준 ({{ s.cur_label }} 집행 캠페인 {{ n_campaigns }}개)</p>
    </div>
    <div class="pc-grid">
      {%- for k in kpis %}
      <div class="pc-card">
        <div class="pc-label">{{ k.label }}</div>
        <div class="pc-row prev">
          <span class="pc-tag">{{ s.prev_label }}</span>
          {%- if k.prev %}<span class="pc-num count-up" data-target="{{ k.prev_raw }}" data-suffix="{{ k.suffix }}" data-decimals="{{ k.decimals }}">{{ k.prev }}</span>
          {%- else %}<span class="pc-num pending">입력 필요</span>{% endif %}
        </div>
        <div class="pc-row cur">
          <span class="pc-tag">{{ s.cur_label }}</span>
          {%- if k.cur %}<span class="pc-num count-up" data-target="{{ k.cur_raw }}" data-suffix="{{ k.suffix }}" data-decimals="{{ k.decimals }}">{{ k.cur }}</span>
          {%- else %}<span class="pc-num pending">입력 필요</span>{% endif %}
        </div>
        {{ chg(k.delta) }}
        {%- if k.note %}<div class="pc-diff">{{ k.note | safe }}</div>{% endif %}
      </div>
      {%- endfor %}
    </div>
    <div class="focus-banner">
      <div class="icon">🎯</div>
      <div class="txt"><b>{{ headline.title }}</b><span>{{ headline.text }}</span></div>
    </div>
  </div>

  <!-- ② 금월 최대 이슈 -->
  <div class="section">
    <div class="section-head">
      <p class="section-title">② {{ s.cur_label }} 최대 이슈 — 광고비 1위 핵심 캠페인</p>
      <p class="section-sub">{{ s.prev_label }}에도 집행된 캠페인 중 {{ s.cur_label }} 집행 광고비가 가장 많은 캠페인 (캠페인 ID 기준 매칭)</p>
    </div>
    {%- if issue %}
    <div class="compare-grid">
      {{ comp_card('prev', '📅 ' ~ s.prev_label, issue.prev.name, s.prev_label ~ ' 실적', issue.rows) }}
      {{ comp_card('cur', '📅 ' ~ s.cur_label, issue.cur.name, s.cur_label ~ ' 실적 · 전체 광고비의 ' ~ '%.1f'|format(issue.share) ~ '%', issue.rows) }}
    </div>
    {%- if issue.renamed %}<div class="note">ℹ️ 캠페인명이 변경되었습니다: '{{ issue.prev.name }}' → '{{ issue.cur.name }}' (동일 캠페인 ID {{ issue.cur.id }})</div>{% endif %}
    {%- else %}
    <div class="pending-box">{{ s.prev_label }}에도 집행된 캠페인이 없어 비교할 수 없습니다. ({{ s.cur_label }} 캠페인이 모두 신규)</div>
    {%- endif %}
  </div>

  <!-- ③ 최대 효율 캠페인 -->
  <div class="section">
    <div class="section-head">
      <p class="section-title">③ {{ s.cur_label }} 최고 효율 캠페인 (ROAS 기준)</p>
      <p class="section-sub">
        {%- if best and best.mode == 'same' %}동일 캠페인의 {{ s.prev_label }} 성과와 비교
        {%- elif best %}{{ s.prev_label }}에 동일 캠페인이 없어 {{ s.prev_label }} 최고 효율 캠페인과 비교
        {%- endif %} · 광고비 {{ '{:,.0f}'.format(s.min_cost) }}원 이상 캠페인 대상</p>
    </div>
    {%- if best %}
    <div class="compare-grid">
      {%- if best.prev %}
      {{ comp_card('prev', '🏆 ' ~ s.prev_label ~ (' · 동일 캠페인' if best.mode == 'same' else ' · 최고 효율'), best.prev.name, s.prev_label ~ ' 실적', best.rows) }}
      {%- else %}
      <div class="comp-card prev"><span class="comp-badge">🏆 {{ s.prev_label }}</span><p class="comp-name">비교 대상 없음</p><p class="comp-desc">{{ s.prev_label }}에 전환이 발생한 캠페인이 없습니다.</p></div>
      {%- endif %}
      {{ comp_card('cur', '🏆 ' ~ s.cur_label ~ ' · 최고 효율', best.cur.name, s.cur_label ~ ' 실적', best.rows) }}
    </div>
    {%- else %}
    <div class="pending-box">{{ s.cur_label }}에 전환 매출이 발생한 캠페인이 없습니다.</div>
    {%- endif %}
  </div>

  <!-- ④ 3단계 요약 -->
  <div class="section">
    <div class="section-head">
      <p class="section-title">④ 개선점 &amp; 이슈 요약</p>
      <p class="section-sub">데이터 기반 3단계 정리</p>
    </div>
    <div class="steps">
      {%- for st in steps %}
      <div class="step">
        <div class="step-no"><i>{{ loop.index }}</i>STEP {{ loop.index }}</div>
        <p class="step-title">{{ st.title }}</p>
        {%- set lines = st.text | step_lines %}
        <ul class="step-list">
          {%- for ln in lines if ln.kind == 'item' %}<li>{{ ln.html }}</li>{% endfor %}
        </ul>
        {%- for ln in lines if ln.kind == 'conc' %}<p class="step-conc">{{ ln.html }}</p>{% endfor %}
      </div>
      {%- endfor %}
    </div>
  </div>

  <!-- ⑤ 캠페인 진행 현황 -->
  <div class="section">
    <div class="section-head">
      <p class="section-title">⑤ {{ s.cur_label }} 캠페인 진행 현황</p>
      <p class="section-sub">광고비 순 · 목표 ROAS/일 예산은 광고센터 설정값 기준</p>
    </div>
    <div class="camp-grid">
      {%- for c in campaigns %}
      <div class="camp-card">
        {%- if c.achieve is none %}<span class="camp-status st-none">목표 미입력</span>
        {%- elif c.hit %}<span class="camp-status st-hit">목표 달성</span>
        {%- else %}<span class="camp-status st-miss">목표 미달</span>{% endif %}
        {%- if c.is_new %}<span class="camp-status st-new">신규</span>{% endif %}
        <p class="camp-title">{{ c.name }}</p>
        <div class="camp-meta"><span>목표 ROAS</span><b{% if not c.target %} class="pending"{% endif %}>{{ c.target or '확인 필요' }}</b></div>
        <div class="camp-meta"><span>일 예산</span><b{% if not c.budget %} class="pending"{% endif %}>{{ c.budget or '확인 필요' }}</b></div>
        <div class="camp-meta sep"><span>집행 광고비</span><b>{{ c.cost }}</b></div>
        <div class="camp-meta"><span>매출</span><b>{{ c.revenue }}</b></div>
        <div class="camp-meta"><span>ROAS</span><b{% if c.achieve is not none %} style="color:{{ 'var(--good)' if c.hit else 'var(--red)' }};"{% endif %}>{{ c.roas }}</b></div>
        <div class="camp-meta"><span>CVR</span><b>{{ c.cvr }}</b></div>
        {%- if c.achieve is not none %}
        <div class="goal-bar-wrap">
          <div class="goal-bar-label"><span>목표 달성률</span><span>{{ '%.1f'|format(c.achieve) }}%</span></div>
          <div class="goal-bar-track"><div class="goal-bar-fill {{ 'hit' if c.hit else 'miss' }}" data-fill="{{ '%.1f'|format(c.fill) }}"></div></div>
        </div>
        {%- endif %}
      </div>
      {%- endfor %}
    </div>

    {%- if campaigns %}
    <p class="top5-title">🏆 캠페인별 TOP {{ s.top_n }} 성과 상품</p>
    <div class="tab-bar" role="tablist" aria-label="캠페인 선택">
      {%- for c in campaigns %}
      <button type="button" class="tab-btn{% if loop.first %} active{% endif %}" data-camp="{{ c.idx }}">{{ c.name }}</button>
      {%- endfor %}
    </div>
    <div class="sort-bar" role="group" aria-label="정렬 기준">
      <span>정렬 기준</span>
      <button type="button" class="sort-btn active" data-sort="roas">ROAS</button>
      <button type="button" class="sort-btn" data-sort="cvr">CVR</button>
    </div>
    {%- for c in campaigns %}
    {%- for key in ['roas', 'cvr'] %}
    <div class="tab-panel{% if loop.first and c.idx == 0 %} active{% endif %}" data-camp="{{ c.idx }}" data-sort="{{ key }}">
      <div class="top5-note">
        광고 집행 상품 {{ c.top.n_products }}개 중 전환 발생 {{ c.top.n_converting }}개 ·
        {%- if key == 'roas' %} ROAS 높은 순 · 상품 광고비 {{ '{:,.0f}'.format(s.min_product_cost) }}원 이상만{% else %} CVR 높은 순 · 클릭 {{ s.min_clicks }}회 이상 상품만{% endif %}
      </div>
      {%- set rows = c.top[key] %}
      {%- if rows %}
      <div class="table-wrap">
      <table class="top5-table">
        <tr><th>#</th><th>상품명</th><th>집행 광고비</th><th>전환 매출</th><th>클릭</th><th>주문</th>
          {%- if key == 'roas' %}<th>CVR</th><th>ROAS</th>{% else %}<th>ROAS</th><th>CVR</th>{% endif %}</tr>
        {%- for r in rows %}
        <tr><td class="rank">{{ loop.index }}</td><td class="name" title="{{ r.full_name }}">{{ r.name }}</td>
          <td>{{ r.cost }}</td><td>{{ r.revenue }}</td><td>{{ r.clicks }}</td><td>{{ r.orders }}</td>
          {%- if key == 'roas' %}<td>{{ r.cvr }}</td><td class="key">{{ r.roas }}</td>{% else %}<td>{{ r.roas }}</td><td class="key">{{ r.cvr }}</td>{% endif %}</tr>
        {%- endfor %}
      </table>
      </div>
      {%- else %}
      <div class="empty">조건에 맞는 상품이 없습니다{% if key == 'cvr' %} (클릭 {{ s.min_clicks }}회 이상 상품 없음){% endif %}.</div>
      {%- endif %}
    </div>
    {%- endfor %}
    {%- endfor %}
    {%- endif %}
  </div>

  <footer>본 보고서는 쿠팡 광고 보고서 원본 데이터(광고전환 {{ s.window }} 기준)로 자동 생성되었습니다 · {{ s.account }} 계정 광고 운영 보고서</footer>
</div>

<script id="report-data" type="application/json">{{ data_json | safe }}</script>
<script>
(function(){
  // ---- TOP 상품: 캠페인 탭 × 정렬(ROAS/CVR) ----
  var state = {camp:'0', sort:'roas'};
  var panels = document.querySelectorAll('.tab-panel');
  function render(){
    panels.forEach(function(p){ p.classList.toggle('active', p.dataset.camp === state.camp && p.dataset.sort === state.sort); });
    document.querySelectorAll('.tab-btn').forEach(function(b){ var on = b.dataset.camp === state.camp; b.classList.toggle('active', on); b.setAttribute('aria-selected', on); });
    document.querySelectorAll('.sort-btn').forEach(function(b){ var on = b.dataset.sort === state.sort; b.classList.toggle('active', on); b.setAttribute('aria-pressed', on); });
  }
  document.querySelectorAll('.tab-btn').forEach(function(b){ b.addEventListener('click', function(){ state.camp = b.dataset.camp; render(); }); });
  document.querySelectorAll('.sort-btn').forEach(function(b){ b.addEventListener('click', function(){ state.sort = b.dataset.sort; render(); }); });

  // ---- 숫자 카운트업 ----
  function fmt(v, d){ return new Intl.NumberFormat('ko-KR', {minimumFractionDigits:d, maximumFractionDigits:d}).format(v); }
  function countUp(el){
    var target = parseFloat(el.dataset.target), suffix = el.dataset.suffix || '', d = parseInt(el.dataset.decimals || '0', 10), t0 = null;
    if (isNaN(target)) return;
    function step(ts){
      if (!t0) t0 = ts;
      var k = Math.min((ts - t0) / 1100, 1), e = 1 - Math.pow(1 - k, 3);
      el.textContent = fmt(target * e, d) + suffix;
      if (k < 1) requestAnimationFrame(step); else el.textContent = fmt(target, d) + suffix;
    }
    requestAnimationFrame(step);
  }

  // ---- 스크롤 리빌 ----
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function reveal(sec){
    sec.classList.add('reveal');
    if (!reduce) sec.querySelectorAll('.count-up').forEach(countUp);
    sec.querySelectorAll('.goal-bar-fill').forEach(function(bar){ requestAnimationFrame(function(){ bar.style.width = bar.dataset.fill + '%'; }); });
  }
  if (!('IntersectionObserver' in window)) { document.querySelectorAll('.section').forEach(reveal); return; }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(en){ if (en.isIntersecting){ reveal(en.target); io.unobserve(en.target); } });
  }, {threshold:0.12});
  document.querySelectorAll('.section').forEach(function(sec){ io.observe(sec); });
})();
</script>
{% include "_editor.html.j2" %}
</body>
</html>
