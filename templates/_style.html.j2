<style>
  :root{
    --bg:#FAFAFF; --card:#FFFFFF; --border:#E4E4F0; --text:#14142B; --sub:#6E7191;
    --indigo:#5B4FE5; --indigo-light:#8C7CFF; --indigo-bg:#EEEDFE;
    --teal:#14b8a6; --teal-bg:#E1F5EE; --teal-ink:#085041;
    --amber:#FF7A45; --amber-bg:#FFF1E9; --amber-ink:#7A3B1D;
    --red:#EB5757; --red-bg:#FDECEC; --up:#E5484D; --down:#2F6FED; --good:#0a8a5f;
  }
  *{box-sizing:border-box;}
  body{margin:0; font-family:'Pretendard','Apple SD Gothic Neo','Malgun Gothic',sans-serif; background:var(--bg); color:var(--text); line-height:1.55;}
  .wrap{max-width:1040px; margin:0 auto; padding:48px 28px 80px;}
  header{margin-bottom:36px;}
  .eyebrow{display:inline-block; font-size:13px; font-weight:600; color:var(--indigo); background:var(--indigo-bg); padding:5px 14px; border-radius:999px; margin-bottom:14px;}
  h1{font-size:30px; font-weight:800; margin:0 0 8px; letter-spacing:-0.5px;}
  .meta{color:var(--sub); font-size:14px;}

  .section{margin-top:52px;}
  .section-head{margin-bottom:18px;}
  .section-title{font-size:20px; font-weight:800; margin:0;}
  .section-sub{font-size:13px; color:var(--sub); margin:4px 0 0;}

  .pc-grid{display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:12px;}
  .pc-card{background:var(--card); border:1px solid var(--border); border-radius:18px; padding:18px 18px 16px; box-shadow:0 4px 20px rgba(20,20,43,0.05);}
  .pc-label{font-size:12px; color:var(--sub); font-weight:700; margin-bottom:12px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  .pc-row{display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:4px 6px; padding:8px 0; border-bottom:1px dashed var(--border);}
  .pc-row .pc-num{margin-left:auto;}
  .pc-row:last-of-type{border-bottom:none;}
  .pc-tag{font-size:10.5px; font-weight:700; padding:2px 8px; border-radius:999px; white-space:nowrap;}
  .pc-row.prev .pc-tag{background:var(--indigo-bg); color:var(--indigo);}
  .pc-row.cur .pc-tag{background:var(--teal-bg); color:var(--teal-ink);}
  .pc-num{font-size:16px; font-weight:800; white-space:nowrap; font-variant-numeric:tabular-nums;}
  .pending{font-size:12px!important; font-weight:600!important; color:var(--sub)!important; font-style:italic;}
  .pc-diff{margin-top:10px; font-size:11.5px; font-weight:700; text-align:center; padding:6px 4px; border-radius:8px; background:var(--bg); color:var(--sub); line-height:1.6;}

  .trend-card{margin-top:14px; background:var(--card); border:1px solid var(--border); border-radius:18px; padding:18px 20px 10px; box-shadow:0 4px 20px rgba(20,20,43,0.05);}
  .trend-head{display:flex; justify-content:space-between; align-items:center; gap:10px 18px; flex-wrap:wrap;}
  .trend-title{margin:0; font-size:13px; font-weight:800; color:var(--text);}
  .trend-legend{display:flex; flex-wrap:wrap; gap:14px; font-size:12px; font-weight:700; color:var(--sub);}
  .trend-legend span{display:inline-flex; align-items:center; gap:6px;}
  .trend-plot{position:relative; overflow-x:auto; -webkit-overflow-scrolling:touch;}
  .trend-plot svg{display:block; width:100%; min-width:760px; height:auto; overflow:visible; font-family:inherit;}
  .trend-plot .tg{stroke:var(--border); stroke-width:1;}
  .trend-plot .tl{font-size:11px; fill:var(--sub); font-variant-numeric:tabular-nums;}
  .trend-plot .tx{font-size:12px; font-weight:800; fill:var(--text);}
  .trend-plot .tx.sm{font-size:10.5px; font-weight:600; fill:var(--sub);}
  .trend-plot .th{font-size:12px; font-weight:800; fill:var(--indigo);}
  .trend-plot .tdiv{stroke:var(--sub); stroke-width:1; stroke-dasharray:3 4; opacity:.5;}
  .trend-note{margin:2px 0 6px; font-size:11.5px; color:var(--sub);}
  .trend-unit{margin-left:6px; padding:2px 8px; border-radius:999px; background:var(--indigo-bg); color:var(--indigo); font-size:11px; font-weight:700;}
  .trend-plot .dl{font-size:12px; font-weight:800; fill:var(--text); font-variant-numeric:tabular-nums;}
  .trend-plot .dl .dn{font-weight:600; fill:var(--sub);}
  .trend-plot .hit{fill:transparent; cursor:crosshair;}
  .trend-plot .hit.on{fill:rgba(91,79,229,.06);}
  .trend-tip{position:absolute; z-index:5; min-width:190px; padding:10px 12px; border-radius:12px; background:#fff; border:1px solid var(--border); box-shadow:0 10px 28px rgba(20,20,43,.14); font-size:12px; pointer-events:none;}
  .trend-tip b{display:block; font-size:12.5px; margin-bottom:6px;}
  .trend-tip .row{display:flex; align-items:center; gap:8px; padding:2px 0; white-space:nowrap;}
  .trend-tip .row i{width:8px; height:8px; border-radius:2px; flex:none;}
  .trend-tip .row span{color:var(--sub); flex:1;}
  .trend-tip .row em{font-style:normal; font-weight:800; font-variant-numeric:tabular-nums;}
  .chg{text-align:right; font-size:11px; font-weight:800; margin-top:3px; min-height:16px;}
  .chg.up{color:var(--up);} .chg.down{color:var(--down);} .chg.flat{color:var(--sub);}

  .focus-banner{background:linear-gradient(135deg,var(--indigo) 0%,var(--indigo-light) 100%); border-radius:20px; padding:26px 28px; color:#fff; margin-top:18px; display:flex; align-items:center; gap:18px; flex-wrap:wrap;}
  .focus-banner .icon{font-size:28px;}
  .focus-banner .txt{flex:1; min-width:240px;}
  .focus-banner .txt b{font-size:15px; display:block; margin-bottom:4px; line-height:1.4;}
  .focus-banner .txt span{font-size:13px; opacity:0.9;}

  .compare-grid{display:grid; grid-template-columns:1fr 1fr; gap:18px;}
  .comp-card{background:var(--card); border:1px solid var(--border); border-radius:18px; padding:24px 24px 20px; box-shadow:0 4px 20px rgba(20,20,43,0.05);}
  .comp-card.prev{border-top:4px solid var(--indigo);}
  .comp-card.cur{border-top:4px solid var(--teal);}
  .comp-badge{display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:700; padding:5px 12px; border-radius:999px; margin-bottom:14px; white-space:nowrap;}
  .comp-card.prev .comp-badge{background:var(--indigo-bg); color:var(--indigo);}
  .comp-card.cur .comp-badge{background:var(--teal-bg); color:var(--teal-ink);}
  .comp-name{font-size:16px; font-weight:800; margin:0 0 2px; word-break:keep-all;}
  .comp-desc{font-size:12px; color:var(--sub); margin:0 0 14px;}
  .comp-block{padding:9px 0; border-bottom:1px dashed var(--border);}
  .comp-block:last-child{border-bottom:none;}
  .comp-row{display:flex; justify-content:space-between; align-items:center; gap:10px; font-size:13px;}
  .comp-row .l{color:var(--sub); white-space:nowrap;}
  .comp-row .v{font-weight:700; white-space:nowrap; font-variant-numeric:tabular-nums;}
  .comp-row .v.hl{color:var(--indigo); font-size:15px;}
  .comp-card.cur .comp-row .v.hl{color:var(--teal-ink);}

  .note{margin-top:16px; font-size:12px; color:var(--sub); background:var(--card); border:1px dashed var(--border); border-radius:12px; padding:12px 16px;}
  .pending-box{background:var(--amber-bg); border:1px dashed #F5B99A; border-radius:14px; padding:16px 20px; font-size:13.5px; color:var(--amber-ink);}

  .steps{display:grid; grid-template-columns:repeat(3,1fr); gap:14px;}
  .step{background:var(--card); border:1px solid var(--border); border-radius:16px; padding:18px 18px 16px; box-shadow:0 4px 16px rgba(20,20,43,0.04); position:relative;}
  .step-no{display:inline-flex; align-items:center; gap:6px; font-size:11.5px; font-weight:800; color:var(--indigo); margin-bottom:6px;}
  .step-no i{font-style:normal; width:22px; height:22px; border-radius:50%; background:var(--indigo); color:#fff; display:inline-flex; align-items:center; justify-content:center; font-size:12px;}
  .step:nth-child(2) .step-no{color:var(--amber);} .step:nth-child(2) .step-no i{background:var(--amber);}
  .step:nth-child(3) .step-no{color:var(--good);} .step:nth-child(3) .step-no i{background:var(--good);}
  .step-title{font-size:15px; font-weight:800; margin:0 0 6px;}
  .step-list{list-style:none; margin:4px 0 0; padding:0; display:flex; flex-direction:column; gap:7px;}
  .step-list li{position:relative; padding-left:12px; font-size:13.5px; font-weight:600; line-height:1.5; word-break:keep-all;}
  .step-list li::before{content:''; position:absolute; left:0; top:.62em; width:5px; height:5px; border-radius:50%; background:var(--border);}
  .step-conc{margin:12px 0 0; padding:8px 12px; border-radius:10px; background:var(--indigo-bg); color:var(--indigo); font-size:13px; font-weight:800;}
  .d-up{color:var(--up); font-weight:800; white-space:nowrap;}
  .d-down{color:var(--down); font-weight:800; white-space:nowrap;}

  .camp-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:14px;}
  .camp-card{background:var(--card); border:1px solid var(--border); border-radius:16px; padding:18px 18px 16px; box-shadow:0 4px 16px rgba(20,20,43,0.04);}
  .camp-status{display:inline-block; font-size:11px; font-weight:700; padding:3px 10px; border-radius:999px; margin:0 4px 10px 0; white-space:nowrap;}
  .st-hit{background:var(--teal-bg); color:var(--teal-ink);} .st-miss{background:var(--red-bg); color:#791F1F;}
  .st-none{background:var(--bg); color:var(--sub); border:1px solid var(--border);} .st-new{background:var(--amber-bg); color:var(--amber-ink);}
  .camp-title{font-size:14.5px; font-weight:800; margin:0 0 10px; word-break:keep-all; line-height:1.4;}
  .camp-meta{font-size:12px; color:var(--sub); display:flex; justify-content:space-between; align-items:center; gap:8px; padding:4px 0;}
  .camp-meta b{color:var(--text); font-weight:700; white-space:nowrap; font-variant-numeric:tabular-nums;}
  .camp-meta.sep{border-top:1px dashed var(--border); margin-top:6px; padding-top:8px;}
  .goal-bar-wrap{margin-top:8px;}
  .goal-bar-label{display:flex; justify-content:space-between; font-size:10.5px; color:var(--sub); margin-bottom:4px;}
  .goal-bar-track{height:7px; border-radius:5px; background:var(--border); overflow:hidden;}
  .goal-bar-fill{height:100%; border-radius:5px; width:0%; transition:width 1.2s cubic-bezier(.22,.9,.35,1);}
  .goal-bar-fill.hit{background:linear-gradient(90deg,#0a8a5f,#1fc98b);}
  .goal-bar-fill.miss{background:linear-gradient(90deg,#E5484D,#ff8a8f);}

  .top5-title{font-size:15px; font-weight:800; margin:34px 0 4px;}
  .top5-note{font-size:11.5px; color:var(--sub); margin:8px 0 10px;}
  .tab-bar{display:flex; flex-wrap:wrap; gap:8px; margin-top:12px;}
  .tab-btn,.sort-btn{font:700 12.5px/1 inherit; padding:8px 14px; border-radius:999px; border:1px solid var(--border); background:#fff; color:var(--sub); cursor:pointer; transition:all .2s ease;}
  .tab-btn:hover,.sort-btn:hover{border-color:var(--indigo-light); color:var(--indigo);}
  .tab-btn.active{background:var(--indigo); color:#fff; border-color:var(--indigo);}
  .sort-bar{display:flex; align-items:center; gap:8px; margin-top:16px;}
  .sort-bar span{font-size:12px; font-weight:700; color:var(--sub);}
  .sort-btn.active{background:var(--teal); color:#fff; border-color:var(--teal);}
  .tab-panel{display:none;} .tab-panel.active{display:block; animation:fadeIn .35s ease;}
  @keyframes fadeIn{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;}}
  .table-wrap{overflow-x:auto; border-radius:14px; box-shadow:0 4px 16px rgba(20,20,43,0.04);}
  table.top5-table{width:100%; border-collapse:collapse; background:var(--card);}
  table.top5-table th{background:var(--indigo); color:#fff; font-size:11.5px; font-weight:700; text-align:right; padding:9px 12px; white-space:nowrap;}
  table.top5-table td{font-size:12.5px; padding:9px 12px; border-bottom:1px solid var(--border); white-space:nowrap; text-align:right; font-variant-numeric:tabular-nums;}
  table.top5-table th:nth-child(-n+2), table.top5-table td:nth-child(-n+2){text-align:left;}
  table.top5-table tr:last-child td{border-bottom:none;}
  table.top5-table td.rank{font-weight:800; color:var(--sub); width:28px;}
  table.top5-table td.name{white-space:normal; font-weight:600; min-width:200px;}
  table.top5-table td.key{font-weight:800; color:var(--indigo);}
  table.top5-table tr:nth-child(2) td.key{color:var(--good);}
  .empty{padding:18px; text-align:center; color:var(--sub); font-size:12.5px; background:var(--card); border-radius:14px; border:1px dashed var(--border);}

  footer{margin-top:60px; padding-top:20px; border-top:1px solid var(--border); font-size:12px; color:var(--sub);}

  .pc-card,.comp-card,.camp-card,.step{transition:transform .25s ease, box-shadow .25s ease;}
  .pc-card:hover,.comp-card:hover,.camp-card:hover,.step:hover{transform:translateY(-4px); box-shadow:0 14px 32px rgba(91,79,229,0.16);}
  .section{opacity:0; transform:translateY(18px); transition:opacity .6s ease, transform .6s ease;}
  .section.reveal{opacity:1; transform:none;}
  @media (max-width:900px){ .pc-grid{grid-template-columns:repeat(3,minmax(0,1fr));} .camp-grid{grid-template-columns:repeat(2,1fr);} }
  @media (max-width:720px){
    .wrap{padding:32px 16px 60px;} h1{font-size:24px;}
    .pc-grid{grid-template-columns:repeat(2,minmax(0,1fr));} .compare-grid,.camp-grid,.steps{grid-template-columns:1fr;}
  }
  @media (prefers-reduced-motion:reduce){ .section{opacity:1; transform:none; transition:none;} .goal-bar-fill{transition:none;} }
  @media print{ .section{opacity:1; transform:none;} }
</style>
